{
 "cases": [
  {
   "name": "nothing",
   "files": {},
   "expect": {
    "$map": [
     [
      "connections",
      []
     ]
    ]
   },
   "after": {
    "cfg/config.yaml": null,
    "cfg/session.yaml": null,
    "cfg/config.example.yaml": null
   }
  },
  {
   "name": "config_only",
   "files": {
    "cfg/config.yaml": "window:\n  width: 1000\nconnections:\n- host: inline\n"
   },
   "expect": {
    "$map": [
     [
      "window",
      {
       "$map": [
        [
         "width",
         {
          "$int": "1000"
         }
        ]
       ]
      }
     ],
     [
      "connections",
      [
       {
        "$map": [
         [
          "host",
          "inline"
         ]
        ]
       }
      ]
     ]
    ]
   },
   "after": {
    "cfg/config.yaml": "window:\n  width: 1000\nconnections:\n- host: inline\n",
    "cfg/session.yaml": null,
    "cfg/config.example.yaml": null
   }
  },
  {
   "name": "session_list",
   "files": {
    "cfg/config.yaml": "window:\n  width: 1000\n",
    "cfg/session.yaml": "# c\n- host: a\n  user: u\n- just a string\n- host: b\n"
   },
   "expect": {
    "$map": [
     [
      "window",
      {
       "$map": [
        [
         "width",
         {
          "$int": "1000"
         }
        ]
       ]
      }
     ],
     [
      "connections",
      [
       {
        "$map": [
         [
          "host",
          "a"
         ],
         [
          "user",
          "u"
         ]
        ]
       },
       {
        "$map": [
         [
          "host",
          "b"
         ]
        ]
       }
      ]
     ]
    ]
   },
   "after": {
    "cfg/config.yaml": "window:\n  width: 1000\n",
    "cfg/session.yaml": "# c\n- host: a\n  user: u\n- just a string\n- host: b\n",
    "cfg/config.example.yaml": null
   }
  },
  {
   "name": "session_mapping",
   "files": {
    "cfg/config.yaml": "connections: [{host: old}]\nfavorites: []\n",
    "cfg/session.yaml": "connections:\n- host: new\n"
   },
   "expect": {
    "$map": [
     [
      "connections",
      [
       {
        "$map": [
         [
          "host",
          "new"
         ]
        ]
       }
      ]
     ],
     [
      "favorites",
      []
     ]
    ]
   },
   "after": {
    "cfg/config.yaml": "connections: [{host: old}]\nfavorites: []\n",
    "cfg/session.yaml": "connections:\n- host: new\n",
    "cfg/config.example.yaml": null
   }
  },
  {
   "name": "session_empty_keeps_inline",
   "files": {
    "cfg/config.yaml": "connections:\n- host: inline\n",
