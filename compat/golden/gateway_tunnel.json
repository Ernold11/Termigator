{
 "cases": [
  {
   "name": "t:0:basic",
   "fn": "tunnel",
   "host": "10.0.0.5",
   "port": {
    "$int": "3389"
   },
   "gw": {
    "$map": [
     [
      "label",
      "bastion"
     ],
     [
      "host",
      "bastion.example"
     ],
     [
      "user",
      "jump"
     ],
     [
      "local_forwards",
      [
       "1:x:1"
      ]
     ],
     [
      "remote_command",
      "tmux"
     ],
     [
      "x11_forwarding",
      true
     ]
    ]
   },
   "local_port": {
    "$int": "40000"
   },
   "launch": {
    "$map": [
     [
      "ssh_keepalive",
      false
     ]
    ]
   },
   "which": [
    "sshpass"
   ],
   "expect": [
    "ssh",
    "-o",
    "BatchMode=yes",
    "-N",
    "-o",
    "ExitOnForwardFailure=yes",
    "-L",
    "127.0.0.1:40000:10.0.0.5:3389",
    "jump@bastion.example"
   ]
  },
