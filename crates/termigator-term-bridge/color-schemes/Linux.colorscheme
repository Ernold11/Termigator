# Termigator built-in colour scheme: Linux.
# Plain values of the palette; written for this project (not copied from Konsole).

[Background]
Color=0,0,0

[Foreground]
Color=255,255,255

[Color0]
Color=0,0,0

[Color1]
Color=170,0,0

[Color2]
Color=0,170,0

[Color3]
Color=170,85,0

[Color4]
Color=0,0,170

[Color5]
Color=170,0,170

[Color6]
Color=0,170,170

[Color7]
Color=170,170,170

[Color0Intense]
Color=85,85,85

[Color1Intense]
Color=255,85,85

[Color2Intense]
Color=85,255,85

[Color3Intense]
Color=255,255,85

[Color4Intense]
Color=85,85,255

[Color5Intense]
Color=255,85,255

[Color6Intense]
Color=85,255,255

[Color7Intense]
Color=255,255,255
